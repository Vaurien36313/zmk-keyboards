#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "keys_it.h"
/ {
    macros {
        // Select BT profile N, then go back to layer 0
        bt_to0: bt_select_to_base {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings
                = <&macro_param_1to2>
                , <&macro_tap &bt BT_SEL 0>
                , <&macro_tap &to 0>
                ;
        };
    };
    behaviors {
        // hold: momentary layer 1 | double-tap: go to layer 1
        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mo 1>, <&to 1>;
        };

        // hold: momentary layer 2 | double-tap: go to layer 2
        td2: tap_dance_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mo 2>, <&to 2>;
        };

        // hold: base keys (layer 4) | double-tap: back to layer 0
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mo 4>, <&to 0>;
        };

        // BLE layer access (keep as tap-dance for multi-tap protection)
        btl: ble_layer {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <1000>;
            bindings = <&kp ESC>, <&kp ESC>, <&kp ESC>, <&kp ESC>, <&to 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        
        layer0 {
            label = "base";
            bindings = <
                &btl &kp N1 &kp N2 &kp N3 &kp N4 &kp N5     &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS 
                &kp LALT &kp Q &kp W &kp E &kp R &kp T        &kp Y &kp U &kp I &kp O &kp P &kp LBKT 
                &kp CAPS &kp A &kp S &kp D &kp F &kp G        &kp H &kp J &kp K &kp L &kp SEMICOLON &kp SQT 
                &kp TAB  &kp Z &kp X &kp C &kp V &kp B            &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp BSLH 

                &kp C_VOL_DN &kp C_VOL_UP                 &kp C_PP &kp C_NEXT 
                &kp LWIN &kp BSPC                  &kp SPACE &kp RET 
                &td1  &kp LALT                         &kp LCTRL  &kp LSHFT 
                &kp LCTRL  &kp LSHFT            &kp DEL &td2
            >;
        };
        
        layer1 {
            label = "left";
            bindings = <
                &kp F12 &kp F1 &kp F2 &kp F3 &kp F4 &kp F5                                                              &trans &trans &trans &trans &trans &trans
                &kp F17 &trans &trans &kp UP &trans &kp F18                                                              &trans &trans &trans &trans &trans &trans 
                &kp GRAVE &kp PAUSE_BREAK &kp LEFT &kp DOWN &kp RIGHT &kp F13                                                   &trans &trans &trans &trans &trans &trans 
                &kp SPACE &kp C_BRI_DN &kp C_BRI_UP &kp C_AL_CALC &kp PSCRN &kp NUBS          &trans &trans &trans &trans &trans &trans 

                &kp C_MUTE &trans                                                                                       &trans &trans 
                &trans &kp DELETE                                                                                       &trans &trans 
                &td0 &trans                                                                                   &trans &trans 
                &trans &trans                                                                                   &trans &trans
            >;
        };
        
        layer2 {
            label = "right";
            bindings = <
                &trans &trans &trans &trans &trans &trans     &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 
                &trans &trans &trans &trans &trans &trans     &kp KP_SLASH &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp EQUAL &kp RBKT 
                &trans &trans &trans &trans &trans &trans     &kp KP_ASTERISK &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_NUMLOCK &kp SQT 
                &trans &trans &trans &trans &trans &trans     &kp KP_MINUS &kp KP_N1 &kp KP_N2 &kp KP_N3 &trans &kp BSLH 
                &trans &trans                                       &kp C_PREV &trans 
                &trans &trans                                       &kp KP_PLUS &trans 
                &trans &trans                                       &kp KP_N0 &trans 
                &trans &trans                                       &kp KP_DOT &td0
            >;
        };
        
        layer3 {
            label = "BLE";
            bindings = <
                &to 0   &bt_to0 0 &bt_to0 1 &bt_to0 2 &bt_to0 3 &bt_to0 4     &bt_to0 5 &bt_to0 6 &bt_to0 7 &bt_to0 8  &bt_to0 9 &bt BT_CLR
                &kp LCTRL &kp LCTRL &kp LCTRL &kp LCTRL &bootloader &kp LCTRL                                   &kp LCTRL &kp LCTRL &kp LCTRL &kp LCTRL &kp LCTRL &kp LCTRL
                &kp LCTRL &kp LCTRL &kp LCTRL &kp LCTRL &kp LCTRL &kp LCTRL                                   &kp LCTRL &kp LCTRL &kp LCTRL &kp LCTRL &kp LCTRL &kp LCTRL
                &kp LCTRL &kp LCTRL &kp LCTRL &kp LCTRL &kp LCTRL &kp LCTRL                                   &kp LCTRL &kp LCTRL &kp LCTRL &kp LCTRL &kp LCTRL &kp LCTRL 
                &kp LCTRL &kp LCTRL                                                               &kp LCTRL &kp LCTRL               
                &kp LCTRL &kp LCTRL                                                 &kp LCTRL &kp LCTRL                                   
                &kp LCTRL &kp LCTRL                                       &kp LCTRL &kp LCTRL         
                &kp LCTRL &kp LCTRL                                       &kp LCTRL &kp LCTRL
            >;
        };

        layer4 {
            label = "base_hold";
            bindings = <
                &btl &kp N1 &kp N2 &kp N3 &kp N4 &kp N5     &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS 
                &kp LALT &kp Q &kp W &kp E &kp R &kp T        &kp Y &kp U &kp I &kp O &kp P &kp LBKT 
                &kp CAPS &kp A &kp S &kp D &kp F &kp G        &kp H &kp J &kp K &kp L &kp SEMICOLON &kp SQT 
                &kp TAB  &kp Z &kp X &kp C &kp V &kp B        &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp BSLH 

                &kp C_VOL_DN &kp C_VOL_UP                 &kp C_PP &kp C_NEXT 
                &kp LWIN &kp BSPC                         &kp SPACE &kp RET 
                &td1  &kp LALT                        &kp LCTRL  &kp LSHFT 
                &kp LCTRL  &kp LSHFT                      &kp DEL &td2
            >;
        };
        extra2 {
            status = "reserved";
        };
    };
};